# Copy to backend/.env for local development. Never commit the real .env.
# On Render, set these in the service's Environment settings instead.

# ---- Secrets ----
IMD_API_KEY=your-imd-api-key
IMD_EMAIL=your-imd-account-email
IMD_PASSWORD=your-imd-account-password
MAPBOX_ACCESS_TOKEN=your-mapbox-token

# ---- Data paths (relative paths resolve against backend/) ----
DEM_PATH=data/dem/P5_PAN_CD_N22_000_E088_000_DEM_30m.tif
GEOID_GRID_PATH=data/geoid/us_nga_egm96_15.tif
DRAINAGE_GEOJSON_PATH=data/gis/drainage_network.geojson
PUMPING_STATIONS_GEOJSON_PATH=data/gis/pumping_stations.geojson
WATER_BODIES_GEOJSON_PATH=data/gis/water_bodies.geojson
HISTORICAL_WATERLOGGING_PATH=data/historical/waterlogging_points.csv
KMC_BOUNDARY_GEOJSON_PATH=data/gis/kmc_boundary.geojson

# ---- Model ----
MODEL_VERSION=synthetic_v1

# ---- Route / spatial tuning ----
ROUTE_SAMPLE_DISTANCE_M=75
HISTORICAL_WATERLOGGING_RADIUS_M=250
DRAIN_MAX_SEARCH_RADIUS_M=500
PUMP_MAX_SEARCH_RADIUS_M=3000
WATERBODY_MAX_SEARCH_RADIUS_M=1000

# ---- Diagnostics ----
DEBUG_LOG_IMD_RAW=false
